# ---------------------------------------------------------------------------
# Variáveis de ambiente — configure estas mesmas chaves em
# Netlify → Site configuration → Environment variables.
# Não coloque valores reais ou senhas neste arquivo, e não faça commit dele
# com valores preenchidos.
# ---------------------------------------------------------------------------

NODE_ENV=production

# Supabase — banco de dados (use a Connection String do "Session Pooler")
SUPABASE_DB_POOLER_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# Supabase — projeto e Storage (para upload de imagens dos produtos)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Primeiro administrador do painel.
# O bucket público "crvl-images" deve existir no Supabase Storage antes do
# primeiro upload (Storage → New bucket → nome "crvl-images" → Public bucket).
# Configure ADMIN_EMAIL e ADMIN_PASSWORD direto no Netlify (nunca no repositório).
ADMIN_EMAIL=admin@crvlstore.com.br
ADMIN_PASSWORD=
