# Copie este arquivo para .env (uso local com `netlify dev`) ou configure as
# mesmas variáveis em Netlify → Site configuration → Environment variables
# para o deploy real. NUNCA commite o arquivo .env de verdade (com valores
# reais) — só este .env.example, com placeholders.

# ---------- Obrigatórias ----------

# Connection string do Supabase — use a do "Session Pooler" (Database →
# Connect → Session pooler), NÃO a conexão direta. Isso é o que evita o erro
# de "max clients reached" em ambiente serverless (ver netlify/functions/lib/db.js).
SUPABASE_DB_POOLER_URL=postgres://postgres.xxxxxxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# URL do projeto Supabase (Project Settings → API).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service role key (Project Settings → API → service_role secret).
# Nunca exponha isso no frontend — só é lido no backend (netlify/functions).
SUPABASE_SERVICE_ROLE_KEY=

# E-mail e senha do administrador único. Trocar e fazer novo deploy (ou
# esperar o próximo cold start) atualiza as credenciais automaticamente.
ADMIN_EMAIL=admin@crvlstore.com.br
ADMIN_PASSWORD=

# ---------- Opcionais (Analytics) ----------

# Dias até um evento/sessão de Analytics antigo ser apagado. Padrão: 400.
# ANALYTICS_RETENTION_DAYS=400

# Geolocalização aproximada por IP (país/estado/cidade) no painel de
# Analytics. Deixe vazio/comentado para manter desligado (nenhuma chamada
# externa, nenhum dado de localização salvo) — ver README.md, seção 7.
# IPGEO_PROVIDER=ipapi
# IPGEO_API_KEY=

# ---------- Só para desenvolvimento local ----------

# Force o cookie de sessão a não usar "Secure" (necessário só se você
# acessar o site local por http:// fora do `netlify dev`, que já detecta
# isso sozinho via NETLIFY_DEV).
# NODE_ENV=development
